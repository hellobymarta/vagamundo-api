# Copia este archivo como .env y rellena los valores reales.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Puerto local de la API
PORT=4000

# Cadena de conexión de MongoDB Atlas (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/catalogo?retryWrites=true&w=majority

# Clave para firmar los tokens JWT
JWT_SECRET=una_clave_larga_y_aleatoria
