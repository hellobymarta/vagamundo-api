# Copia este archivo como .env y rellena los valores reales.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Puerto local de la API
PORT=4000

# Cadena de conexión de MongoDB Atlas (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/vagamundo?retryWrites=true&w=majority

# Clave con la que se firman los tokens de sesión. Una frase larga y distinta
# en cada entorno: si cambia, las sesiones abiertas dejan de valer.
JWT_SECRET=una_clave_larga_y_aleatoria

# Direcciones desde las que se acepta que llamen a la API, separadas por comas:
# la del frontend en local y la del frontend desplegado.
CORS_ORIGIN=http://localhost:5173,https://vagamundo-web.vercel.app

# Activa los mensajes de depuración de la API (opcional)
DEBUG=vagamundo:*
