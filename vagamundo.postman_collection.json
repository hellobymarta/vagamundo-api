{
  "info": {
    "name": "Vagamundo API",
    "description": "Colección para probar la API de Vagamundo: sesión, catálogo de viajes, diario, reservas y panel. Empieza por «Entrar»: su script guarda el token en la variable {{token}} y el resto de peticiones ya lo usan. Cambia {{base}} por la URL de Vercel para probar el despliegue.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:4000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "id",
      "value": "REEMPLAZA_POR_UN_ID"
    }
  ],
  "item": [
    {
      "name": "Sesión",
      "item": [
        {
          "name": "Estado de la API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/",
              "host": [
                "{{base}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Comprueba que la API responde. No toca la base de datos."
          }
        },
        {
          "name": "Entrar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Devuelve el token de sesión y lo guarda en {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"marta@vagamundo.es\",\n  \"password\": \"vagamundo2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el token en la variable de la colección para no copiarlo a mano.",
                  "const datos = pm.response.json();",
                  "if (datos.token) pm.collectionVariables.set('token', datos.token);",
                  "pm.test('Entra y devuelve token', () => pm.expect(datos.token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Entrar con contraseña incorrecta",
          "request": {
